  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "update:all": "npm install @playwright/test@latest @types/node@latest && npx playwright install && npm outdated && npm install @playwright/mcp@latest",
    "update:playwright": "npm install @playwright/test@latest && npx playwright install",
    "update:types": "npm install @types/node@latest",
    "update:browsers": "npx playwright install",
    "update:check": "npm outdated",
    "version:check": "echo Playwright: && npx playwright --version && echo Node: && node --version && echo TypeScript: && npx tsc --version && echo NPM: && npm --version",
    "shard:1": "npx playwright test --shard=1/2 --workers=2",
    "shard:2": "npx playwright test --shard=2/2 --workers=2",
    "db:setup": "tsx db/database.ts",
    "scheduler:start": "tsx automation/cronScheduler.ts",
    "test:cucumber": "cucumber-js"
  },
  "keywords": [],
